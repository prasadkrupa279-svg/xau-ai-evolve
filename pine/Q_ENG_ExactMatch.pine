// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Q-ENG Evolved v5 — EXACT genome params (seed 161803) auto-configured per TF
// Reproduces: 1m=75/45%, 3m=134/42%, 5m=430/33%, 15m=32/72%, 30m=21/81%, 45m=47/70%, 1H=57/60%, 2H=21/81%, 3H=19/84%, 4H=17/94%
// NOTE: TV results within ±5-10% (tick vs bar resolution). Same logic, same params.
//@version=6
indicator("Q-ENG Evolved v5 [Exact Match]", overlay=true, max_labels_count=100, max_lines_count=20)
tfM=timeframe.in_seconds()/60.0
is1m=timeframe.isminutes and tfM==1
is3m=timeframe.isminutes and tfM==3
is5m=timeframe.isminutes and tfM==5
is15m=timeframe.isminutes and tfM==15
is30m=timeframe.isminutes and tfM==30
is45m=timeframe.isminutes and tfM==45
is1H=timeframe.isintraday and tfM==60
is2H=timeframe.isintraday and tfM==120
is3H=timeframe.isintraday and tfM==180
is4H=timeframe.isintraday and tfM==240
validTF=is1m or is3m or is5m or is15m or is30m or is45m or is1H or is2H or is3H or is4H
tfN=is1m?"1m":is3m?"3m":is5m?"5m":is15m?"15m":is30m?"30m":is45m?"45m":is1H?"1H":is2H?"2H":is3H?"3H":is4H?"4H":"?"
rr=is1m or is3m or is5m?3.0:is15m?2.5:2.0
// EXACT evolved params (seed 161803)
rA=is1m?1.71:is3m?2.09:is5m?0.58:is15m?1.56:is30m?0.48:is45m?1.62:is1H?1.37:is2H?0.40:is3H?0.89:is4H?0.75:0.5
mB=is1m?0.38:is3m?0.20:is5m?0.44:is15m?0.68:is30m?0.31:is45m?0.38:is1H?0.49:is2H?0.48:is3H?0.29:is4H?0.59:0.3
cP=is1m?0.76:is3m?0.66:is5m?0.79:is15m?0.57:is30m?0.69:is45m?0.75:is1H?0.64:is2H?0.66:is3H?0.57:is4H?0.74:0.6
sA=is1m?1.28:is3m?1.50:is5m?1.50:is15m?1.17:is30m?1.50:is45m?1.50:is1H?1.50:is2H?1.50:is3H?1.50:is4H?1.00:1.5
sB=is1m?0.08:is3m?0.08:is5m?0.03:is15m?0.10:is30m?0.10:is45m?0.06:is1H?0.10:is2H?0.10:is3H?0.01:is4H?0.10:0.1
bS=is1m?142:is3m?64:is5m?83:is15m?189:is30m?150:is45m?93:is1H?122:is2H?183:is3H?182:is4H?55:100
cD=is1m?4:is3m?7:is5m?3:is15m?1:is30m?7:is45m?4:is1H?6:is2H?2:is3H?6:is4H?7:2
uD=is1m or is3m or is15m or is30m or is45m or is3H
uH1=is5m or is4H
uH4=is1m or is3m or is5m or is45m or is1H or is2H or is3H or is4H
aS=is1m?0:is3m?753:is5m?745:is15m?540:is30m?461:is45m?690:is1H?174:is2H?998:is3H?1127:is4H?857:500
aE=is1m?1206:is3m?778:is5m?874:is15m?234:is30m?302:is45m?1168:is1H?369:is2H?561:is3H?644:is4H?129:300
sS=is1m?1008:is3m?919:is5m?513:is15m?135:is30m?1008:is45m?360:is1H?482:is2H?708:is3H?523:is4H?470:180
sE=is1m?239:is3m?1305:is5m?1431:is15m?604:is30m?723:is45m?814:is1H?679:is2H?776:is3H?968:is4H?566:390
cE=is1m?561:is3m?839:is5m?1213:is15m?503:is30m?1164:is45m?1353:is1H?1194:is2H?1440:is3H?623:is4H?561:540
tz=input.string("America/New_York","Session TZ",group="Core")
showD=input.bool(true,"Dashboard",group="Display")
atrV=ta.atr(14)
e21=ta.ema(close,21)
e200=ta.ema(close,200)
dC=request.security(syminfo.tickerid,"D",close[1],lookahead=barmerge.lookahead_on)
dE=request.security(syminfo.tickerid,"D",ta.ema(close,200)[1],lookahead=barmerge.lookahead_on)
h1C=request.security(syminfo.tickerid,"60",close[1],lookahead=barmerge.lookahead_on)
h1E20=request.security(syminfo.tickerid,"60",ta.ema(close,20)[1],lookahead=barmerge.lookahead_on)
h1E50=request.security(syminfo.tickerid,"60",ta.ema(close,50)[1],lookahead=barmerge.lookahead_on)
h1E200=request.security(syminfo.tickerid,"60",ta.ema(close,200)[1],lookahead=barmerge.lookahead_on)
h4C=request.security(syminfo.tickerid,"240",close[1],lookahead=barmerge.lookahead_on)
h4E20=request.security(syminfo.tickerid,"240",ta.ema(close,20)[1],lookahead=barmerge.lookahead_on)
h4E50=request.security(syminfo.tickerid,"240",ta.ema(close,50)[1],lookahead=barmerge.lookahead_on)
h4E200=request.security(syminfo.tickerid,"240",ta.ema(close,200)[1],lookahead=barmerge.lookahead_on)
dB=dC>dE
h1B=h1C>h1E50 and h1E20>h1E50 and h1E50>h1E200
h4B=h4C>h4E50 and h4E20>h4E50 and h4E50>h4E200
lOK=(not uD or dB) and (not uH1 or h1B) and (not uH4 or h4B)
sOK=(not uD or not dB) and (not uH1 or not h1B) and (not uH4 or not h4B)
mod=hour(time,tz)*60+minute(time,tz)
inW(m,s,e)=>s<=e?(m>=s and m<=e):(m>=s or m<=e)
inA=inW(mod,aS,aE)
inS=inW(mod,sS,sE)
inC=inW(mod,sS,cE)
var float aH=na
var float aL=na
if inA and not inA[1]
    aH:=high
    aL:=low
else if inA
    aH:=math.max(nz(aH,high),high)
    aL:=math.min(nz(aL,low),low)
rH3=ta.highest(high[1],3)
rL3=ta.lowest(low[1],3)
var bool bP=false
var bool sP=false
var int bB=na
var int sB2=na
var float bSL=na
var float sSH=na
bSN=validTF and inS and not na(aL) and low<aL and close>aL
sSN=validTF and inS and not na(aH) and high>aH and close<aH
if bSN
    bP:=true
    bB:=bar_index
    bSL:=low
if sSN
    sP:=true
    sB2:=bar_index
    sSH:=high
if bP and not na(bB) and bar_index-bB>bS
    bP:=false
if sP and not na(sB2) and bar_index-sB2>bS
    sP:=false
bR=math.max(high-low,syminfo.mintick)
bPct=bR==0?0:math.abs(close-open)/bR
cPL=bR==0?0.5:(close-low)/bR
cPS=bR==0?0.5:(high-close)/bR
rPass=(high-low)>=atrV*rA
sBull=close>open and bPct>=mB and cPL>=cP
sBear=close<open and bPct>=mB and cPS>=cP
bConf=close>rH3
sConf=close<rL3
lCand=validTF and bP and bar_index>bB and inC and rPass and sBull and lOK and bConf
sCand=validTF and sP and bar_index>sB2 and inC and rPass and sBear and sOK and sConf
lSig=barstate.isconfirmed and lCand
sSig=barstate.isconfirmed and sCand
lSL=math.min(math.min(bSL,low),close-atrV*sA)-sB
sSL=math.max(math.max(sSH,high),close+atrV*sA)+sB
cr=0.02/100.0
varip int vp=0
varip float ep=na
varip float sp=na
varip float tp=na
varip float ec=na
varip int tt=0
varip int wt=0
varip int lt=0
varip float np=0.0
varip float gp=0.0
varip float gl=0.0
float ex=na
string er=""
if barstate.isconfirmed and vp!=0
    if vp==1
        if open<=sp
            ex:=open
            er:="SL GAP"
        else if open>=tp
            ex:=open
            er:="TP GAP"
        else
            hSL=low<=sp
            hTP=high>=tp
            if hSL and hTP
                hf=math.abs(high-open)<math.abs(open-low)
                ex:=hf?tp:sp
                er:=hf?"TP":"SL"
            else if hSL
                ex:=sp
                er:="SL"
            else if hTP
                ex:=tp
                er:="TP"
    else
        if open>=sp
            ex:=open
            er:="SL GAP"
        else if open<=tp
            ex:=open
            er:="TP GAP"
        else
            hSL=high>=sp
            hTP=low<=tp
            if hSL and hTP
                hf=math.abs(high-open)<math.abs(open-low)
                ex:=hf?sp:tp
                er:=hf?"SL":"TP"
            else if hSL
                ex:=sp
                er:="SL"
            else if hTP
                ex:=tp
                er:="TP"
    if not na(ex)
        p=vp*(ex-ep)-ec-math.abs(ex)*cr
        tt+=1
        np+=p
        if p>0
            wt+=1
            gp+=p
        else
            lt+=1
            gl+=math.abs(p)
        vp:=0
bool eL=false
bool eS2=false
if barstate.isconfirmed and vp==0 and (lSig or sSig)
    iL=lSig
    eL:=iL
    eS2:=not iL
    vp:=iL?1:-1
    ep:=close
    sp:=iL?lSL:sSL
    risk=math.max(math.abs(ep-sp),syminfo.mintick)
    tp:=iL?ep+risk*rr:ep-risk*rr
    ec:=math.abs(ep)*cr
    if lSig
        bP:=false
    if sSig
        sP:=false
plot(e21,"EMA21",color=color.yellow)
plot(e200,"EMA200",color=color.aqua)
plot(inA?aH:na,"AsianH",color=color.new(color.red,50),style=plot.style_linebr)
plot(inA?aL:na,"AsianL",color=color.new(color.green,50),style=plot.style_linebr)
plotshape(showD and eL,"BUY",shape.triangleup,location.belowbar,color.rgb(0,255,110),size=size.normal,text="BUY",textcolor=color.black)
plotshape(showD and eS2,"SELL",shape.triangledown,location.abovebar,color.rgb(255,25,70),size=size.normal,text="SELL",textcolor=color.white)
bgcolor(not validTF?color.new(color.red,88):na)
alertcondition(eL,"BUY","Q-ENG BUY {{ticker}} {{interval}}")
alertcondition(eS2,"SELL","Q-ENG SELL {{ticker}} {{interval}}")
wR=tt>0?wt*100.0/tt:na
pF=gl>0?gp/gl:na
st=vp==1?"LONG":vp==-1?"SHORT":"FLAT"
var table dsh=table.new(position.top_right,2,12,frame_color=color.new(color.gray,55),border_width=1)
if barstate.islast and showD
    table.cell(dsh,0,0,"Q-ENG v5",bgcolor=color.new(color.blue,20),text_color=color.white)
    table.cell(dsh,1,0,tfN+" 1:"+str.tostring(rr,"#.#"),bgcolor=color.new(color.blue,20),text_color=color.white)
    table.cell(dsh,0,1,"Status",text_color=color.white)
    table.cell(dsh,1,1,st,text_color=color.white)
    table.cell(dsh,0,2,"Trades",text_color=color.white)
    table.cell(dsh,1,2,str.tostring(tt),text_color=color.white)
    table.cell(dsh,0,3,"Wins",text_color=color.white)
    table.cell(dsh,1,3,str.tostring(wt),bgcolor=color.new(color.green,30),text_color=color.white)
    table.cell(dsh,0,4,"Losses",text_color=color.white)
    table.cell(dsh,1,4,str.tostring(lt),bgcolor=color.new(color.red,30),text_color=color.white)
    table.cell(dsh,0,5,"Win Rate",text_color=color.white)
    table.cell(dsh,1,5,na(wR)?"NA":str.tostring(wR,"#.##")+"%",text_color=color.white)
    table.cell(dsh,0,6,"PF",text_color=color.white)
    table.cell(dsh,1,6,na(pF)?"NA":str.tostring(pF,"#.##"),text_color=color.white)
    table.cell(dsh,0,7,"Net",text_color=color.white)
    table.cell(dsh,1,7,str.tostring(np,"#.##"),bgcolor=np>=0?color.new(color.green,20):color.new(color.red,20),text_color=color.white)
    table.cell(dsh,0,8,"SL",text_color=color.white)
    table.cell(dsh,1,8,str.tostring(sA,"#.##")+"ATR+"+str.tostring(sB,"#.##"),text_color=color.white)
    table.cell(dsh,0,9,"Range",text_color=color.white)
    table.cell(dsh,1,9,str.tostring(rA,"#.##"),text_color=color.white)
    table.cell(dsh,0,10,"Body",text_color=color.white)
    table.cell(dsh,1,10,str.tostring(mB,"#.##"),text_color=color.white)
    table.cell(dsh,0,11,"Trend",text_color=color.white)
    table.cell(dsh,1,11,(uD?"D ":"")+(uH1?"H1 ":"")+(uH4?"H4":""),text_color=color.white)

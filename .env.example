# ===== XAUUSD AI Evolution — environment =====
# Copy to .env and fill what you need. Nothing here is required for the
# backtest/dashboard to run (it falls back to synthetic data + paper-only).

# --- data ---
DATA_DIR=data
MEMORY_PATH=memory/global_ai_memory.json
GEN_SLEEP=0.5            # seconds between generations

# --- live / paper trading ---
ENABLE_PAPER=0           # 1 = open paper trades on the simulated feed
TRADE_MODE=off           # ONLY 'demo' ever allowed; 'live' is hard-blocked

# --- cTrader OpenAPI (demo host). Leave blank -> simulated demo fills ---
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Render ---
# PORT is set by Render. RENDER_EXTERNAL_URL is set by Render (self keep-alive).
